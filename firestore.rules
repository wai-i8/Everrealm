rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Phase 3 Step 5: permanent gameplay state is server-authoritative.
    // Browsers may read their own save, but every mutation must pass through
    // authenticated Callable Functions using the Admin SDK.
    match /players/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    // Single-device session ownership remains a client-authenticated concern.
    match /sessions/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /world/config {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
