rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Phase 3 Step 5: permanent gameplay state is server-authoritative.
    // Browsers may read their own save, but every mutation must pass through
    // authenticated Callable Functions using the Admin SDK.
    match /players/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    // Social graph data is readable only by its owning player. Mutations are
    // server-authoritative through socialCommand so friendship changes remain
    // symmetric and cannot be forged by a browser client.
    match /players/{userId}/friends/{friendId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /players/{userId}/friendRequests/{requesterId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /players/{userId}/friendRequestsSent/{targetId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /players/{userId}/whisperPeers/{peerId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // One server-authoritative outgoing invitation lock is shared across
    // friend, trade and party requests so a client cannot spam parallel invites.
    match /players/{userId}/outgoingInvite/{stateId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }


    // Trading is fully server-authoritative. Clients may only observe their
    // own invitations/pointer plus sessions where they are a participant.
    match /players/{userId}/tradeInvites/{tradeId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /players/{userId}/tradeState/{stateId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /tradeSessions/{tradeId} {
      allow read: if request.auth != null && (
        resource.data.participants.a.uid == request.auth.uid ||
        resource.data.participants.b.uid == request.auth.uid
      );
      allow write: if false;
    }


    // Party membership and shared battle state are server-authoritative. The
    // client can observe only its own invite/pointer and party/battle documents
    // that explicitly list the authenticated player as a member.
    match /players/{userId}/partyInvites/{inviteId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /players/{userId}/partyState/{stateId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /players/{userId}/pvpInvites/{inviteId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /players/{userId}/pvpState/{stateId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /parties/{partyId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.memberUids;
      allow write: if false;
    }

    match /partyBattles/{battleId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.memberUids;
      allow write: if false;
    }

    match /pvpBattles/{battleId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.memberUids;
      allow write: if false;
    }

    // Single-device session ownership remains a client-authenticated concern.
    match /sessions/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /world/config {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
